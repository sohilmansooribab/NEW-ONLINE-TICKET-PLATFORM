# CineBook Backend Environment Configuration (Template)
# Copy this file to .env and configure for your local environment

# Server Port
PORT=5000

# Application Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String (Placeholder URI)
MONGODB_URI=mongodb://127.0.0.1:27017/cinebook

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# JWT Authentication Configuration (Placeholders)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Seat Hold Expiration (Seconds)
HOLD_DURATION_SECONDS=300

# Razorpay Test Mode Payment Gateway Credentials (Placeholders)
# Obtain test credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
